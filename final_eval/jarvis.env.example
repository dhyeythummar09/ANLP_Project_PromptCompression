# Copy this file to final_eval/jarvis.env (ignored by Git).
# One Jarvislabs key serves all models. Never paste keys into chat or JSON.
JARVISLABS_API_KEY=
JARVISLABS_BASE_URL=https://models.jarvislabs.net/v1

# Copy the exact API model ID from Token Factory's request example.
# Display names are not necessarily API IDs. Fill DeepSeek first.
JARVISLABS_DEEPSEEK_MODEL=

# Optional: fill now if convenient; blank entries are skipped with --models all.
JARVISLABS_GPTOSS_MODEL=
JARVISLABS_GLM_MODEL=
# Confirmed Token Factory ID (22 October 2026); diagnostic requests low reasoning.
JARVISLABS_QWEN_MODEL=qwen-3.8-27b-fp8
